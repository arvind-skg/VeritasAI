# PostgreSQL Connection URL (Render Managed DB, Neon, Supabase, AWS RDS, or Local Postgres)
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veritasai?schema=public"
# Hosted example (Render / Supabase / Neon):
# DATABASE_URL="postgresql://user:password@ep-host-12345.us-east-1.aws.neon.tech/veritasai?sslmode=require"
PORT=4000
COOL_APPLICATION_ID="veritasai"
ADMIN_PASSWORD="veritasai-admin"
JWT_SECRET="veritasai-jwt-secret-change-in-production"
# AES-256-GCM Master Encryption Key for Database Field-Level Encryption at Rest (32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
