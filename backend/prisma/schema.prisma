// VeritasAI Prisma Schema — Multi-Tenant Architecture
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       User[]
  agents      Agent[]
  events      Event[]
  auditLogs   AuditLog[]
}

model User {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String       @unique
  passwordHash String
  name         String
  role         String       @default("ADMIN") // ADMIN, MEMBER, AUDITOR
  createdAt    DateTime     @default(now())

  auditLogs    AuditLog[]
}

model Agent {
  id           String            @id @default(cuid())
  orgId        String?
  organization Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  type         String            @default("CUSTOM") // LOAN_APPROVAL, CUSTOMER_SUPPORT, REFUND, TRIAGE, CUSTOM
  environment  String            @default("PRODUCTION") // PRODUCTION, STAGING, TEST
  status       String            @default("ACTIVE") // ACTIVE, DISABLED, REVOKED
  apiKey       String?           // Retained for backward compatibility
  baselineModel String?          // For model change / drift detection
  baselinePromptHash String?     // Baseline system prompt hash
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt @default(now())

  credentials  AgentCredential[]
  events       Event[]
}

model AgentCredential {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name        String    @default("Primary Key")
  keyPrefix   String    // e.g. "vra_live_" or "vra_test_"
  keyHash     String    @unique // SHA-256 hash of the complete secret key
  lastFour    String    // e.g. "a9f3" for safe dashboard display
  status      String    @default("ACTIVE") // ACTIVE, REVOKED
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

model Event {
  id           String        @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  eventType    String
  decision     String?       // e.g. "approved", "rejected", "escalated"
  riskLevel    String        @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  inputJson    String?       // Data-minimized / sanitized input context
  outputJson   String?       // Output decisions / payload
  metadataJson String?       // Additional non-sensitive routing metadata
  requestId    String?       // Tracing request ID
  status       String        // "recorded" | "recording_failed"
  receiptJson  String?       // Full CooL receipt
  errorDetail  String?       // Recording failure explanation
  verdictJson  String?       // 7-domain verify verdict (cached)
  verifiedAt   DateTime?

  // Enterprise Provenance & Action Chain Features
  parentEventId              String?   // Cross-Event Causal Chain
  actionChainJson            String?   // 9-Stage cryptographically linked lifecycle
  policyProofJson            String?   // Policy name, version, hash, rules
  humanApprovalJson          String?   // Human-in-the-loop review, signature, decision
  modelProvenanceJson        String?   // Model, version, prompt hash, tool versions, RAG snapshot
  toolCallsJson              String?   // Consequential tool calls, params hash, execution outcome
  selectiveCommitmentsJson   String?   // Salted field commitments & Merkle tree root
  externalTimestampJson      String?   // RFC 3161 / OpenTimestamps trust anchor
  logIndex                   Int?      // Append-only Transparency Log index
  treeHeadHash               String?   // Signed Tree Head (STH) root hash

  createdAt    DateTime      @default(now())
}

model AuditLog {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String       // e.g. "AGENT_CREATED", "KEY_ROTATED", "KEY_REVOKED", "AGENT_STATUS_CHANGED"
  resourceType String       // "AGENT", "CREDENTIAL", "ORGANIZATION"
  resourceId   String?
  detailsJson  String?
  createdAt    DateTime     @default(now())
}
