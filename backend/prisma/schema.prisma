// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  apiKey    String   @unique
  createdAt DateTime @default(now())
  events    Event[]
}

model Event {
  id           String    @id @default(cuid())
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id])
  eventType    String
  status       String    // "recorded" | "recording_failed"
  receiptJson  String?   // JSON string — full receipt from cool.record(); null if recording_failed
  errorDetail  String?   // set only when status = recording_failed
  verdictJson  String?   // JSON string — last verifyEvidence() result, cached
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
}
